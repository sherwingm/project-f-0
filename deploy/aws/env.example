# ~/fo_scanner/.env on the AWS VM (guides/17-always-on-host.md). One KEY=value per line, no quotes.
# chmod 600. Never commit the filled-in copy.
KOTAK_CONSUMER_KEY=
DATA_PROVIDER=kotak
ORDERS=true
PAPER=true
BROKER=none
SCAN_URL=https://raw.githubusercontent.com/sherwingm/project-f-0/main/data/scan.json
PUBLIC_ACCESS=false
APP_PASSWORD=
ALLOW_LOTTERY=false
RISK_PER_TRADE_PCT=6
MAX_OPEN_POSITIONS=3
# The paper account's durable copy (paper-state branch). Only ONE server may write it: remove it from Render first.
LEDGER_GITHUB_TOKEN=
LEDGER_GITHUB_REPO=sherwingm/project-f-0
# Optional
UPSTOX_ANALYTICS_TOKEN=
ANTHROPIC_API_KEY=
TZ=Asia/Kolkata

# Phone alerts (server/alerts.py): a Telegram bot from @BotFather; chat id from `.venv/bin/python -m server.alerts --chat-id`
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
