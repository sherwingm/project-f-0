# copy to .env and fill in; the server reads these at start (uvicorn --env-file .env)
APP_PASSWORD=change-me
DATA_PROVIDER=none     # none | kotak | upstox | groww | kite | fake   where live quotes come from
KOTAK_CONSUMER_KEY=    # Neo app -> More -> Trade API -> Generate application -> copy token (enough for live data)
KOTAK_MOBILE=          # +91XXXXXXXXXX   } only needed for real orders through Kotak
KOTAK_UCC=             #                 }
KOTAK_TOTP_SECRET=     # TOTP Registration on the Trade API dashboard   }
KOTAK_MPIN=            #                 }
KOTAK_CHAIN_CALLS_PER_POLL=12
UPSTOX_ANALYTICS_TOKEN=  # account.upstox.com/developer/apps -> Analytics -> Generate Token (1 year, read-only)
UPSTOX_CHAIN_CALLS_PER_POLL=12
ORDERS=false           # keep false for a read-only scanner; true enables the order sheet (paper unless PAPER=false)
BROKER=none            # none | kotak | groww | kite | fake   only used when ORDERS=true
PAPER=true             # keep true until you have tested the flow end to end
KITE_API_KEY=
KITE_API_SECRET=
KITE_ACCESS_TOKEN=     # written daily by: python -m server.kite_login
GROWW_TOTP_TOKEN=      # Groww Cloud API Keys page -> "Generate TOTP token" (does not expire; headless daily login)
GROWW_TOTP_SECRET=
GROWW_ACCESS_TOKEN=    # alternative: paste a token from the same page (expires daily)
GROWW_OI_CALLS_PER_POLL=60
POLL_SECONDS=30
ANTHROPIC_API_KEY=
COMMENTARY_MODEL=claude-sonnet-4-6
MAX_LOTS_PER_ORDER=5
MAX_ORDERS_PER_DAY=20
PAPER_CAPITAL=500000   # paper account start; risk keys (RISK_PER_TRADE_PCT etc) in guide 12
ALLOW_LOTTERY=false    # true trades options < Rs 2 or <= 2 sessions to expiry as the cheap_near_expiry bucket
SCAN_URL=               # hosted server: https://raw.githubusercontent.com/<you>/<repo>/main/data/scan.json
EVENTS_DB=             # event store (default data/events.sqlite); all event/model keys in guide 14
EVENTS_RATE_SECONDS=1  # never fetch exchange data faster than this (shared across sources)
